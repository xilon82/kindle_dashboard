#!/bin/sh
# Diagnostica per il pannello: verifica che il Kindle raggiunga il server e raccoglie informazioni.
#
# Il pannello NON viene disegnato da qui: su questo firmware (FW 5.x, Kindle 4) ne' eips ne' il fbink
# incluso in KOReader mostrano PNG, e fermare il framework per fargli spazio ha prodotto schermo
# bianco e riavvii. Il pannello si guarda nel browser: http://HOST:PORT/panel.html
#
# Nessuna voce ferma il framework, spegne il Wi-Fi o sospende il device: al massimo disegna sullo
# schermo con eips (inventario, immagini, pannello), cosa che si annulla uscendo dalla pagina.
#
# File generato da deploy.ps1: i valori HOST e PORT arrivano da config.toml.

HOST="__HOST__"
PORT="__PORT__"

WORK_DIR="/mnt/us/dashboard"
LOG="$WORK_DIR/dashboard.log"
# Ciclo in background: il pid serve per non avviarne due (regola del pid orfano) e il file STOP per
# fermarlo senza kill a mano. Il framework ridisegna quando KUAL esce, quindi il pannello va ripreso.
PID_FILE="$WORK_DIR/dashboard.pid"
STOP_FILE="$WORK_DIR/STOP"
# 30 s: abbastanza per fermare il ciclo fra due disegni, abbastanza rado da non martellare le fonti.
LOOP_SECONDS=30
# Il framebuffer e' 600x800, mentre la tela servita al browser e' 600x720 (barra degli indirizzi):
# il client nativo chiede l'altezza piena, altrimenti gli ultimi 80 px restano quelli di KUAL.
NATIVE_HEIGHT=800

# KUAL lancia gli script con un PATH minimo: senza questo, "wget" puo' sembrare assente.
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# BusyBox 1.7.2 del Kindle non ha `command -v`: si cerca direttamente nel PATH, senza dipendere da
# applet che questa build potrebbe non avere.
find_cmd() {
    for candidate in "$@"; do
        case "$candidate" in
            */*)
                if [ -x "$candidate" ]; then
                    echo "$candidate"
                    return 0
                fi
                ;;
            *)
                old_ifs="$IFS"
                IFS=:
                for dir in $PATH; do
                    if [ -x "$dir/$candidate" ]; then
                        echo "$dir/$candidate"
                        IFS="$old_ifs"
                        return 0
                    fi
                done
                IFS="$old_ifs"
                ;;
        esac
    done
    return 1
}

WGET="$(find_cmd wget /usr/bin/wget /bin/wget)"
EIPS="$(find_cmd eips /usr/bin/eips /usr/sbin/eips)"
# Il fbink di KOReader e' compilato MINIMAL (senza supporto immagini) ma resta l'unico presente sul
# device: cercarlo serve a documentare *quale* build si sta provando, non a usarlo.
FBINK="$(find_cmd fbink /mnt/us/koreader/fbink /usr/bin/fbink)"

# URL per il client nativo: `h` chiede la tela 600x800, quella del framebuffer, invece dei 600x720
# pensati per il browser. Il timestamp evita di ridisegnare un file gia' visto.
panel_url() {
    printf 'http://%s:%s/panel.png?t=%s&h=%s' "$HOST" "$PORT" "$(date +%s)" "$NATIVE_HEIGHT"
}

mkdir -p "$WORK_DIR"

log() {
    echo "$(date '+%Y-%m-%dT%H:%M:%S') $*" >>"$LOG"
}

# Il log cresce a ogni voce e vive sulla partizione utente da 4 GB: oltre 2000 righe si tiene la
# coda, altrimenti dopo mesi ogni voce di menu diventa lenta a scrivere.
trim_log() {
    [ -f "$LOG" ] || return 0
    if [ "$(wc -l <"$LOG")" -gt 2000 ]; then
        tail -n 1000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
    fi
}

battery_capacity() {
    for candidate in /sys/class/power_supply/*/capacity; do
        if [ -r "$candidate" ]; then
            cat "$candidate"
            return 0
        fi
    done
    return 1
}

# BusyBox 1.7.2 non ha `wget -T`: il timeout si ottiene con un watchdog in background, altrimenti un
# server che non risponde lascia la voce di menu appesa per sempre.
fetch_png() {
    "$WGET" -q -O "$2" "$1" &
    fetch_pid=$!
    ( sleep 15; kill -9 "$fetch_pid" 2>/dev/null ) &
    watchdog_pid=$!
    wait "$fetch_pid"
    fetch_rc=$?
    kill "$watchdog_pid" 2>/dev/null
    return "$fetch_rc"
}

# Firma PNG senza dipendere dal `grep` sui file binari: BusyBox 1.37 (nel container) restituisce 1
# su un PNG valido, BusyBox 1.7.2 (sul Kindle) lo accetta. Si confrontano i primi 4 byte, con un
# ripiego sul testo "PNG" a partire dal secondo byte.
is_png() {
    magic="$(head -c 4 "$1" 2>/dev/null)"
    if [ -n "$magic" ]; then
        [ "$magic" = "$(printf '\211PNG')" ]
        return $?
    fi
    if [ "$(tail -c +2 "$1" 2>/dev/null | head -c 3)" = "PNG" ]; then
        return 0
    fi
    grep -q PNG "$1"
}

# Il pannello si scarica in un file temporaneo e sostituisce quello buono solo se è davvero un PNG:
# un errore HTML o un file troncato non devono cancellare l'ultima immagine valida.
update_panel() {
    tmp="$WORK_DIR/panel.new"
    if ! fetch_png "$(panel_url)" "$tmp"; then
        rm -f "$tmp"
        log "loop: download fallito (tengo l'ultimo panel.png)"
        return 1
    fi
    size=$(wc -c <"$tmp")
    if [ "$size" -lt 1000 ] || ! is_png "$tmp"; then
        rm -f "$tmp"
        log "loop: download non PNG ($size byte, tengo l'ultimo panel.png)"
        return 1
    fi
    mv "$tmp" "$WORK_DIR/panel.png"
    log "loop: scaricato panel.png ($size byte)"
    return 0
}

check() {
    if [ -z "$WGET" ]; then
        log "check: wget non trovato"
        return 1
    fi
    tmp="$WORK_DIR/check.png"
    url="$(panel_url)"
    if ! fetch_png "$url" "$tmp"; then
        rm -f "$tmp"
        log "check: FALLITO $url (PC spento, IP cambiato o firewall)"
        return 1
    fi
    size=$(wc -c <"$tmp")
    # Un HTTP 200 puo' contenere una pagina d'errore: senza questa prova il log direbbe "OK" anche
    # quando il file scaricato non e' un'immagine.
    if [ "$size" -lt 1000 ] || ! is_png "$tmp"; then
        rm -f "$tmp"
        log "check: risposta non PNG ($size byte) da $url"
        return 1
    fi
    log "check: OK $url ($size byte)"
    rm -f "$tmp"
    return 0
}

# Impedisce al Kindle di mostrare il salvascherino mentre il pannello e' aperto nel browser.
# Si tocca solo una proprieta' di sistema: nessun disegno sul framebuffer, nessun framework fermato.
keep_awake() {
    out="$(lipc-set-prop com.lab126.powerd preventScreenSaver 1 2>&1)"
    log "preventScreenSaver=1 -> ${out:-ok}"
}

allow_sleep() {
    out="$(lipc-set-prop com.lab126.powerd preventScreenSaver 0 2>&1)"
    log "preventScreenSaver=0 -> ${out:-ok}"
}

# Una riga per comando, con l'exit code: il log si legge via USB e un output multi-riga lo
# renderebbe illeggibile, mentre l'exit code e' l'unica cosa che distingue "ha funzionato" da
# "ha risposto 0 senza fare nulla" (il caso di eips su questo firmware).
report() {
    label="$1"
    shift
    out="$("$@" 2>&1)"
    rc=$?
    [ -n "$out" ] || out="<vuoto>"
    log "$label exit=$rc: $(printf '%s' "$out" | tr '\n' '|')"
}

which_list() {
    found=""
    for name in curl wget eips fbink file ip ifconfig rtcwake lipc-get-prop lipc-set-prop \
        lipc-wait-event powerd_test openssl od tail tr grep; do
        path="$(find_cmd "$name")"
        if [ -n "$path" ]; then
            found="$found $name=$path"
        else
            found="$found $name=ASSENTE"
        fi
    done
    log "comandi:$found"
}

# Inventario in sola lettura: dice quali strumenti esistono su *questo* firmware invece di dedurlo
# dal nome commerciale del Kindle. Nessun comando qui cambia stato.
inventory() {
    log "=== inventario ==="
    report uname uname -a
    report version sh -c "cat /etc/version 2>/dev/null || cat /etc/version.txt 2>/dev/null"
    report cpu head -n 5 /proc/cpuinfo
    report memoria head -n 3 /proc/meminfo
    report disco sh -c "df -h | head -n 5"
    which_list
    report openssl openssl version
    report wget_help sh -c "wget --help 2>&1 | head -n 5"
    report rtc ls -l /sys/class/rtc
    report power_state cat /sys/power/state
    report processi sh -c "ps | grep -e powerd -e wifid -e framework -e cvm"
    if [ -n "$EIPS" ]; then
        report eips_info "$EIPS" -i
        # `eips` senza argomenti stampa l'uso di *questa* versione: serve a non inventare opzioni.
        report eips_help "$EIPS"
    else
        log "eips_info: eips ASSENTE"
    fi
    if [ -n "$FBINK" ]; then
        report fbink_version "$FBINK" -v
    else
        log "fbink_version: fbink ASSENTE"
    fi
    report wifi_state lipc-get-prop com.lab126.wifid cmState
    report screen_saver lipc-get-prop com.lab126.powerd preventScreenSaver
    log "=== fine inventario ==="
}

# Disegna le varianti di formato con eips, una per volta. Non ferma il framework e non spegne
# nulla: se eips non disegna, lo schermo resta quello di prima. Le varianti arrivano da
# deploy.ps1 -TestImages e si rigenerano con `python kindle\make_test_images.py`.
images() {
    if [ -z "$EIPS" ]; then
        log "images: eips ASSENTE"
        return 1
    fi
    log "=== immagini ==="
    found=0
    for file in "$WORK_DIR"/test/*; do
        [ -f "$file" ] || continue
        found=1
        # -c pulisce lo schermo: senza, un'immagine vecchia puo' sembrare quella nuova.
        "$EIPS" -c >/dev/null 2>&1
        out="$("$EIPS" -f -g "$file" 2>&1)"
        rc=$?
        log "immagine $(basename "$file") exit=$rc ${out:+-> $out}"
        sleep 3
    done
    if [ "$found" -eq 0 ]; then
        log "images: nessun file in $WORK_DIR/test (deploy.ps1 -TestImages)"
    fi
    log "=== fine immagini ==="
}

# Mostra un file gia' presente sul device: separa il problema del download da quello del rendering.
show() {
    file="${1:-$WORK_DIR/panel.png}"
    if [ -z "$EIPS" ]; then
        log "show: eips ASSENTE"
        return 1
    fi
    if [ ! -f "$file" ]; then
        log "show: file assente $file"
        return 1
    fi
    out="$("$EIPS" -f -g "$file" 2>&1)"
    rc=$?
    log "show $(basename "$file") exit=$rc ${out:+-> $out}"
}

# Il framework ridisegna quando KUAL esce, quindi un'immagine disegnata una volta sparisce. Un ciclo
# in background la riprende al giro successivo; non tocca Wi-Fi, sospensione o framework.
loop_running() {
    [ -f "$PID_FILE" ] || return 1
    loop_pid="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$loop_pid" ] || return 1
    kill -0 "$loop_pid" 2>/dev/null
}

# Disegna il pannello gia' scaricato (senza rete: serve anche al warm-up).
draw_panel() {
    "$EIPS" -f -g "$WORK_DIR/panel.png" >/dev/null 2>&1
}

start_loop() {
    if [ -z "$EIPS" ]; then
        log "loop: eips ASSENTE"
        return 1
    fi
    if loop_running; then
        log "loop: gia' in esecuzione (pid $(cat "$PID_FILE"))"
        return 0
    fi
    rm -f "$STOP_FILE"
    log "loop: avvio ogni $LOOP_SECONDS s"
    (
        # Il trap pulisce il pid anche quando lo stop uccide il processo durante il sleep.
        trap 'rm -f "$PID_FILE"' 0
        # Dopo l'uscita di KUAL il framework ridisegna la home (prima il menu, poi la minibar con
        # Wi-Fi e batteria): i primi secondi servono refresh ravvicinati, altrimenti l'immagine resta
        # coperta per uno o due giri. Lo stop uccide comunque il processo subito.
        update_panel
        for _ in 1 2 3; do
            draw_panel
            log "loop: disegnato panel.png (warm-up)"
            sleep 5
        done
        while [ ! -f "$STOP_FILE" ]; do
            update_panel
            draw_panel
            log "loop: disegnato panel.png"
            sleep "$LOOP_SECONDS"
        done
        log "loop: terminato"
    ) &
    echo $! >"$PID_FILE"
}

stop_loop() {
    if loop_running; then
        loop_pid="$(cat "$PID_FILE")"
        touch "$STOP_FILE"
        # `kill` chiude subito, senza aspettare la fine del sleep: altrimenti il pannello ricopre KUAL
        # per altri 15 s e fermare il ciclo diventa una corsa.
        kill "$loop_pid" 2>/dev/null
        # Il trap non scatta sul `kill` in ash: il pid va rimosso qui, altrimenti resta orfano e un
        # pid riusato da un altro processo farebbe credere al ciclo ancora attivo.
        rm -f "$PID_FILE"
        log "loop: fermato (pid $loop_pid)"
    else
        rm -f "$PID_FILE"
        log "loop: non in esecuzione"
    fi
}

diag() {
    log "=== diag ==="
    log "uname: $(uname -a 2>&1)"
    log "wget: ${WGET:-ASSENTE} | eips: ${EIPS:-ASSENTE} | fbink: ${FBINK:-ASSENTE}"
    log "batteria: $(battery_capacity 2>/dev/null || echo sconosciuta)%"
    log "url pannello: http://$HOST:$PORT/panel.html"
    log "url nativa: $(panel_url)"
    check
    log "=== fine diag ==="
}

trim_log

case "$1" in
    check)
        check
        ;;
    diag)
        diag
        ;;
    inventory)
        inventory
        ;;
    images)
        images
        ;;
    show)
        show "$2"
        ;;
    loop)
        start_loop
        ;;
    stop)
        stop_loop
        ;;
    awake)
        keep_awake
        ;;
    sleep)
        allow_sleep
        ;;
    *)
        echo "uso: $0 {check|diag|inventory|images|show [file]|loop|stop|awake|sleep}"
        exit 2
        ;;
esac
